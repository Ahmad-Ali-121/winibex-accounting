# Copy to .env and fill in. .env is never committed.
# The database values below are the local Docker container only. Production
# values come from Hostinger and are set in the hPanel Node app, not here.

NODE_ENV=development
PORT=3000
TZ=UTC

# Local Docker MariaDB 11.8, published on 3307 so it cannot collide with a local install
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=winibex
DB_USER=winibex
DB_PASSWORD=winibex_local

# Separate database for the test run. Tests rebuild it, so it must never
# point at DB_NAME.
DB_TEST_NAME=winibex_test

# bcrypt for now. argon2id is stronger and can be switched on at first deploy.
# See decision 039. Changing this does not invalidate existing hashes: verify
# reads the algorithm from the stored hash itself.
PASSWORD_ALGORITHM=bcrypt

# Long random strings. Generate with: openssl rand -base64 48
# These two are local development values. Production uses different ones,
# set in the Hostinger panel and never committed.
JWT_ACCESS_SECRET=local-development-access-secret-change-in-production
JWT_REFRESH_SECRET=local-development-refresh-secret-change-in-production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# The web app origin only. Comma separated if more than one.
CORS_ORIGINS=http://localhost:8080

# Absolute path, outside the web root
UPLOAD_DIR=

# Protects the daily cron endpoint
CRON_SECRET=
