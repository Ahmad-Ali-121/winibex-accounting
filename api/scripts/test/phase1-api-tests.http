### ---- 6.12 Cheques ------------------------------------------------------------

### 6.12a Issue a cheque. Expect 201: status "issued", amount.minor 4500000.
# @name cheque1
POST {{api}}/cheques
Authorization: Bearer {{owner}}
Content-Type: application/json

{
  "accountId": {{bankId}},
  "chequeNumber": "TEST-000101",
  "payee": "Test Landlord",
  "amount": { "minor": 4500000, "currency": "PKR" },
  "issueDate": "{{today}}"
}

### 6.12b The same cheque number again on the same account.
# Expect 409 ALREADY_EXISTS, "That is already recorded. Something that must
# be unique, such as a cheque number on the same account, is already in use."
# (D8 fixed: this used to answer 500.) No second cheque exists (6.12m).
POST {{api}}/cheques
Authorization: Bearer {{owner}}
Content-Type: application/json

{
  "accountId": {{bankId}},
  "chequeNumber": "TEST-000101",
  "payee": "Someone else",
  "amount": { "minor": 100000, "currency": "PKR" },
  "issueDate": "{{today}}"
}

### 6.12c Straight from issued to cleared.
# Expect 409, "An issued cheque cannot become cleared."
PATCH {{api}}/cheques/{{cheque1.response.body.$.cheque.id}}/status
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "status": "cleared", "clearedOn": "{{today}}" }

### 6.12d Presented. Expect 200, status "presented".
PATCH {{api}}/cheques/{{cheque1.response.body.$.cheque.id}}/status
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "status": "presented" }

### 6.12e Cleared without a date. Expect 400, "Record the date it cleared, so
# the bank statement can be reconciled against it."
PATCH {{api}}/cheques/{{cheque1.response.body.$.cheque.id}}/status
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "status": "cleared" }

### 6.12f Cleared with a date. Expect 200, status "cleared", clearedOn today.
PATCH {{api}}/cheques/{{cheque1.response.body.$.cheque.id}}/status
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "status": "cleared", "clearedOn": "{{today}}" }

### 6.12g Cancel a cleared cheque. Expect 409, "A cleared cheque cannot become
# cancelled."
PATCH {{api}}/cheques/{{cheque1.response.body.$.cheque.id}}/status
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "status": "cancelled" }

### 6.12h The rent payment the cheque paid. Expect 201, amount 4500000.
# @name rentCheque
POST {{api}}/transactions
Authorization: Bearer {{owner}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "date": "{{today}}",
  "direction": "out",
  "method": "cheque",
  "description": "Office rent November by cheque TEST-000101",
  "categoryId": {{cat6200}},
  "accountId": {{bankId}},
  "chequeId": {{cheque1.response.body.$.cheque.id}},
  "reference": "TEST-000101",
  "gross": { "minor": 4500000, "currency": "PKR" }
}

### 6.12i Attach receipt.pdf, then post (6.12j). Expect 201.
POST {{api}}/transactions/{{rentCheque.response.body.$.transaction.id}}/attachments
Authorization: Bearer {{owner}}
Content-Type: multipart/form-data; boundary=WinibexBoundary

--WinibexBoundary
Content-Disposition: form-data; name="file"; filename="receipt.pdf"
Content-Type: application/pdf

< ./receipt.pdf
--WinibexBoundary--

### 6.12j Post. Expect 200, the 22nd journal number.
POST {{api}}/transactions/{{rentCheque.response.body.$.transaction.id}}/approve
Authorization: Bearer {{owner}}
Idempotency-Key: {{$guid}}

### 6.12k Link the cheque to that entry. Expect 200: cheque.transactionId set
# and cheque.journalNumber the 22nd number.
PATCH {{api}}/cheques/{{cheque1.response.body.$.cheque.id}}/transaction
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "transactionId": {{rentCheque.response.body.$.transaction.id}} }

### 6.12l A second cheque, left outstanding. Expect 201, status "issued".
# @name cheque2
POST {{api}}/cheques
Authorization: Bearer {{owner}}
Content-Type: application/json

{
  "accountId": {{bankId}},
