  "categoryId": {{cat6200}},
  "accountId": {{cashId}},
  "gross": { "minor": 5500000, "currency": "PKR" }
}

### 6.11b The same, warning confirmed. Expect 201, amount 5500000.
# @name rentCash
POST {{api}}/transactions
Authorization: Bearer {{owner}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "date": "{{today}}",
  "direction": "out",
  "method": "cash",
  "description": "Office rent October paid in cash",
  "categoryId": {{cat6200}},
  "accountId": {{cashId}},
  "gross": { "minor": 5500000, "currency": "PKR" },
