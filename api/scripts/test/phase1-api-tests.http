# Phase 1 API tests. Used by docs/PHASE1-TEST.md, Parts 4, 6, 7 and 8.
# Expected results match the code after the defect fixes of 2026-10-26
# (D1 to D10, D12, D14).
#
# Open this file in VS Code with the "REST Client" extension (publisher
# Huachao Mao). A "Send Request" link appears above every request. Click it
# and the response opens on the right. Run them in order, top to bottom,
# only when the guide tells you to.
#
# Put three files in the same folder as this one:
#   receipt.pdf   any small PDF
#   receipt.jpg   any small photo
#   notes.txt     any text file (used to prove text files are refused)
#
# Money in every body is paisa. 560000 is PKR 5,600.00.
#
# If any request answers 401 "Your session has expired. Sign in again.",
# send the matching sign-in request in section 0 again and carry on.

# ---------------------------------------------------------------------------
# SETTINGS. Fill these in before the first request.
# ---------------------------------------------------------------------------

@api = http://localhost:3000/api/v1
@today = 2026-10-27
@ownerEmail = winibexoffice@gmail.com
@ownerPassword = Winibex-Local-2026
@testPassword = Winibex-Test-2026
@bankId = 1
@cashId = 2
@pettyId = 3
@staffId = 4
@cat5100 = 14
@cat6200 = 22
@cat6400 = 24
@cat6600 = 27
@coa8100 = 90
@coa8200 = 91
@tax236y = 1
@tax153 = 3

# Tokens, filled automatically by the sign-in requests below.
@owner = {{ownerLogin.response.body.$.accessToken}}
@staff = {{staffLogin.response.body.$.accessToken}}
@admin = {{adminLogin.response.body.$.accessToken}}
@limited = {{limitedLogin.response.body.$.accessToken}}

# The entry from 6.4b.
@card1aId = {{card1aAck.response.body.$.transaction.id}}


###############################################################################
# 0. SIGN IN
###############################################################################

### 0.1 Owner. Expect 200 with accessToken and user.role "owner".
# @name ownerLogin
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "{{ownerEmail}}", "password": "{{ownerPassword}}" }

### 0.2 Test Staff. Expect 200, user.role "staff".
# @name staffLogin
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "staff@winibex.test", "password": "{{testPassword}}" }

### 0.3 Test Admin. Expect 200, user.role "admin".
# @name adminLogin
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "admin@winibex.test", "password": "{{testPassword}}" }

### 0.4 Test Limited Admin. Expect 200, user.role "admin".
# @name limitedLogin
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "limited@winibex.test", "password": "{{testPassword}}" }


###############################################################################
# PART 4. THE OPENING ENTRY
###############################################################################

### 4.1 Staff tries to post the opening entry.
# Expect 403, FORBIDDEN, "Only the owner can post the opening entry."
POST {{api}}/opening-entry
Authorization: Bearer {{staff}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{ "balances": [ { "code": "1113", "amount": 50000000 } ] }

### 4.2 Owner posts the opening entry.
# Bank 500,000, office cash 50,000, petty cash 10,000, director loan 200,000.
# Expect 201: openingEntry.journalNumber is the first number (e.g. JV-1),
# date "2026-07-01", total.minor 56000000, lines 5.
# The fifth line is 3400 Opening balance equity, credit 360,000, which the
# system works out itself.
# If you get "There is no ledger account 2210", remove that line and note it.
POST {{api}}/opening-entry
Authorization: Bearer {{owner}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "description": "Opening balances at 30 June 2026 (TEST)",
  "balances": [
    { "code": "1113", "amount": 50000000 },
    { "code": "1111", "amount": 5000000 },
    { "code": "1112", "amount": 1000000 },
    { "code": "2210", "amount": 20000000 }
  ]
}

### 4.3 A second opening entry.
# Expect 409, OPENING_ALREADY_EXISTS,
# "There is already an opening entry, JV-1."
POST {{api}}/opening-entry
Authorization: Bearer {{owner}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{ "balances": [ { "code": "1113", "amount": 100 } ] }

### 4.4 Merge check right after the opening entry.
# Expect 200: historyMerged false, historicalEntries 0, canMerge false,
# four rows in differences (1111, 1112, 1113, 2210), each difference equal
# to that account's opening figure.
GET {{api}}/history/merge-check
Authorization: Bearer {{owner}}


###############################################################################
# PART 6. FEATURES THAT ONLY HAVE AN API SO FAR
###############################################################################

### 6.2a Who am I. Expect 200, user.role "owner".
GET {{api}}/me
Authorization: Bearer {{owner}}

### 6.2b Dashboard checkpoint after Part 5.
# Expect: cashHeld.minor 83495000, monthIn.minor 32025000,
# monthOut.minor 4280000, pendingCount 0, openFlagCount 10,
# historyMerged false.
GET {{api}}/dashboard
Authorization: Bearer {{owner}}

### 6.2c Accounts checkpoint after Part 5.
# Expect: Winibex bank 78715000, Office cash 3810000, Petty cash 970000,
# every other account 0, total.minor 83495000.
GET {{api}}/accounts
Authorization: Bearer {{owner}}


### ---- 6.3 and 6.4: worked example 1a, a $20 card payment ----------------------

### 6.3 Journal preview. Nothing is saved.
# Expect 200: totals gross 560000, taxTotal 2800, chargesTotal 32500,
# withheldTotal 0, amount 595300. Five lines (order may differ):
#   6400 debit 560000, 8200 debit 28000, 8100 debit 4500,
#   1141 debit 2800, 1113 credit 595300.
POST {{api}}/transactions/preview
Authorization: Bearer {{owner}}
Content-Type: application/json

{
  "date": "{{today}}",
  "direction": "out",
  "method": "card",
  "description": "Claude Team seat, company card, worked example 1a",
  "categoryId": {{cat6400}},
  "accountId": {{bankId}},
  "gross": { "minor": 560000, "currency": "PKR" },
  "foreign": { "minor": 2000, "currency": "USD" },
  "fxRate": "280",
  "fxRateSource": "bank_advice",
  "taxes": [
    { "taxId": {{tax236y}}, "baseAmount": { "minor": 560000, "currency": "PKR" },
      "rateApplied": "0.5000", "atlStatusUsed": "atl", "atlParty": "company",
      "amount": { "minor": 2800, "currency": "PKR" }, "deductedBy": "bank" }
  ],
  "charges": [
    { "type": "forex_fee", "amount": { "minor": 28000, "currency": "PKR" }, "coaId": {{coa8200}}, "note": "Forex fee" },
    { "type": "bank_charge", "amount": { "minor": 4500, "currency": "PKR" }, "coaId": {{coa8100}}, "note": "FED on the fee" }
  ]
}

### 6.4a Create it as a draft.
# Expect 409 VALIDATION_WARNINGS with RATE_DEVIATION, "That rate is 6.67%
# away from 300, used on <today>." 300 is the rate from step 5.9.
# Nothing is saved. (D5 fixed: this warning never fired before.)
POST {{api}}/transactions
Authorization: Bearer {{owner}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "date": "{{today}}",
  "direction": "out",
  "method": "card",
  "description": "Claude Team seat, company card, worked example 1a",
  "categoryId": {{cat6400}},
  "accountId": {{bankId}},
  "gross": { "minor": 560000, "currency": "PKR" },
  "foreign": { "minor": 2000, "currency": "USD" },
  "fxRate": "280",
  "fxRateSource": "bank_advice",
  "taxes": [
    { "taxId": {{tax236y}}, "baseAmount": { "minor": 560000, "currency": "PKR" },
      "rateApplied": "0.5000", "atlStatusUsed": "atl", "atlParty": "company",
      "amount": { "minor": 2800, "currency": "PKR" }, "deductedBy": "bank" }
  ],
  "charges": [
    { "type": "forex_fee", "amount": { "minor": 28000, "currency": "PKR" }, "coaId": {{coa8200}}, "note": "Forex fee" },
    { "type": "bank_charge", "amount": { "minor": 4500, "currency": "PKR" }, "coaId": {{coa8100}}, "note": "FED on the fee" }
  ]
}

### 6.4b Same entry, warning confirmed. Expect 201, transaction.amount 595300.
# @name card1aAck
POST {{api}}/transactions
Authorization: Bearer {{owner}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "date": "{{today}}",
  "direction": "out",
  "method": "card",
  "description": "Claude Team seat, company card, worked example 1a",
  "categoryId": {{cat6400}},
  "accountId": {{bankId}},
  "gross": { "minor": 560000, "currency": "PKR" },
  "foreign": { "minor": 2000, "currency": "USD" },
  "fxRate": "280",
  "fxRateSource": "bank_advice",
  "taxes": [
    { "taxId": {{tax236y}}, "baseAmount": { "minor": 560000, "currency": "PKR" },
      "rateApplied": "0.5000", "atlStatusUsed": "atl", "atlParty": "company",
      "amount": { "minor": 2800, "currency": "PKR" }, "deductedBy": "bank" }
  ],
  "charges": [
    { "type": "forex_fee", "amount": { "minor": 28000, "currency": "PKR" }, "coaId": {{coa8200}}, "note": "Forex fee" },
    { "type": "bank_charge", "amount": { "minor": 4500, "currency": "PKR" }, "coaId": {{coa8100}}, "note": "FED on the fee" }
  ],
  "acknowledged_warnings": ["RATE_DEVIATION"]
}


### 6.4c Try to post it with no receipt.
# Expect 400, RECEIPT_REQUIRED,
# "A payment of this size needs a receipt attached before it can be posted."
POST {{api}}/transactions/{{card1aId}}/approve
Authorization: Bearer {{owner}}
Idempotency-Key: {{$guid}}

### 6.4d Attach receipt.pdf.
# Expect 201: attachment with mime "application/pdf", a sha256, and
# retainUntil about ten years ahead. The entry's "No receipt" flag resolves
# itself (decision 056).
# @name card1aReceipt
POST {{api}}/transactions/{{card1aId}}/attachments
Authorization: Bearer {{owner}}
Content-Type: multipart/form-data; boundary=WinibexBoundary

--WinibexBoundary
Content-Disposition: form-data; name="file"; filename="receipt.pdf"
Content-Type: application/pdf

< ./receipt.pdf
--WinibexBoundary--

### 6.4e Post it. Expect 200: status "posted", journalNumber the 15th (JV-15).
POST {{api}}/transactions/{{card1aId}}/approve
Authorization: Bearer {{owner}}
Idempotency-Key: {{$guid}}

### 6.4f Read it back. Expect 200: five journal lines matching 6.3,
# one transaction_taxes row (TEST-236Y, rate_applied 0.5000, tax_amount 2800),
# two transaction_charges rows (28000 and 4500).
GET {{api}}/transactions/{{card1aId}}
Authorization: Bearer {{owner}}


### ---- 6.5 Vendors -------------------------------------------------------------

### 6.5a A filer company. Expect 201: atlStatus "atl", atlCheckIsStale false,
# canBeWithheldFrom true.
# @name vendorFiler
POST {{api}}/vendors
Authorization: Bearer {{owner}}
Content-Type: application/json

{
  "name": "Test Filer Software House",
  "kind": "company",
  "ntn": "1234567-8",
  "atlStatus": "atl",
  "atlCheckedOn": "{{today}}",
  "country": "Pakistan"
}

### 6.5b An individual with a CNIC but unknown filer status.
# Expect 201: atlStatus "unknown", canBeWithheldFrom true.
# @name vendorUnknown
POST {{api}}/vendors
Authorization: Bearer {{owner}}
Content-Type: application/json

{
  "name": "Test Unknown Contractor",
  "kind": "individual",
  "cnic": "35202-1234567-1",
  "atlStatus": "unknown"
}

### 6.5c A freelancer with no NTN and no CNIC.
# Expect 201: canBeWithheldFrom false.
# @name vendorNoId
POST {{api}}/vendors
Authorization: Bearer {{owner}}
Content-Type: application/json

{
  "name": "Test No-ID Freelancer",
  "kind": "individual",
  "atlStatus": "unknown"
}

### 6.5d Filer status with no check date.
# Expect 400, "Record the date the filer status was checked, so a stale check
# can be spotted later."
POST {{api}}/vendors
Authorization: Bearer {{owner}}
Content-Type: application/json

{ "name": "Test Bad Vendor", "kind": "company", "ntn": "7654321-0", "atlStatus": "atl" }

### 6.5e Search. Expect 200 with the three Test vendors from 6.5a to 6.5c.
GET {{api}}/vendors?q=Test
Authorization: Bearer {{owner}}


### ---- 6.6 Tax suggestions (using the TEST taxes from the seed) ---------------

### 6.6a Taxes in force today. Expect 200 with TEST-236Y, TEST-154A, TEST-153.
GET {{api}}/taxes?date={{today}}
Authorization: Bearer {{owner}}

### 6.6b Paying the filer vendor PKR 100,000 for outsourcing.
# Expect one suggestion: shortCode TEST-153, rateApplied "4.0000",
# atlStatusUsed "atl", atlParty "vendor", amount.minor 400000,
# deductedBy "us", warning null.
GET {{api}}/taxes/suggest?direction=out&base=10000000&categoryId={{cat5100}}&vendorId={{vendorFiler.response.body.$.vendor.id}}&date={{today}}
Authorization: Bearer {{owner}}

### 6.6c Same payment to the vendor with unknown status.
# Expect: rateApplied "8.0000", atlStatusUsed "non_atl", amount.minor 800000,
# warning "Test Unknown Contractor has no confirmed filer status, so the
# non-filer rate is used."
GET {{api}}/taxes/suggest?direction=out&base=10000000&categoryId={{cat5100}}&vendorId={{vendorUnknown.response.body.$.vendor.id}}&date={{today}}
Authorization: Bearer {{owner}}

### 6.6d A USD receipt of PKR 140,250.
# Expect: TEST-154A, rateApplied "1.0000", atlStatusUsed "atl" (Winibex is
# on the ATL), atlParty "company", amount.minor 140250, deductedBy "bank".
GET {{api}}/taxes/suggest?direction=in&base=14025000&currency=USD&date={{today}}
Authorization: Bearer {{owner}}


### ---- 6.7 Worked example 9: paying a vendor with s.153 withheld --------------

### 6.7a Create. Expect 201: gross 10000000, withheldTotal 400000,
# amount 9600000 (only 96,000 leaves the bank).
# @name wh1
POST {{api}}/transactions
Authorization: Bearer {{owner}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "date": "{{today}}",
  "direction": "out",
  "method": "online",
  "description": "Test Filer Software House, app module outsourcing",
  "categoryId": {{cat5100}},
  "accountId": {{bankId}},
  "vendorId": {{vendorFiler.response.body.$.vendor.id}},
  "gross": { "minor": 10000000, "currency": "PKR" },
  "taxes": [
    { "taxId": {{tax153}}, "baseAmount": { "minor": 10000000, "currency": "PKR" },
      "rateApplied": "4.0000", "atlStatusUsed": "atl", "atlParty": "vendor",
      "amount": { "minor": 400000, "currency": "PKR" }, "deductedBy": "us" }
  ]
}

### 6.7b Attach receipt.pdf. Expect 201.
POST {{api}}/transactions/{{wh1.response.body.$.transaction.id}}/attachments
Authorization: Bearer {{owner}}
Content-Type: multipart/form-data; boundary=WinibexBoundary

--WinibexBoundary
Content-Disposition: form-data; name="file"; filename="receipt.pdf"
Content-Type: application/pdf

< ./receipt.pdf
--WinibexBoundary--

### 6.7c Post. Expect 200, posted, the 16th journal number (JV-16).
POST {{api}}/transactions/{{wh1.response.body.$.transaction.id}}/approve
Authorization: Bearer {{owner}}
Idempotency-Key: {{$guid}}

### 6.7d Journal lines. Expect three, each with its code and name (D12):
# 5100 Outsourcing debit 10000000, 2132 Withholding payable credit 400000,
# 1113 Bank credit 9600000.
GET {{api}}/transactions/{{wh1.response.body.$.transaction.id}}/journal
Authorization: Bearer {{owner}}


### ---- 6.8 Withholding from a vendor with no NTN and no CNIC -----------------

### 6.8a Expect 400 MISSING_VENDOR_TAX_ID, field "vendorId", "Test No-ID
# Freelancer has no NTN or CNIC recorded, so tax withheld from them cannot be
# reported." Nothing is saved. (D7 fixed: this used to create the draft.)
POST {{api}}/transactions
Authorization: Bearer {{owner}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "date": "{{today}}",
  "direction": "out",
  "method": "online",
  "description": "Test No-ID Freelancer, logo design",
  "categoryId": {{cat5100}},
  "accountId": {{bankId}},
  "vendorId": {{vendorNoId.response.body.$.vendor.id}},
  "gross": { "minor": 1000000, "currency": "PKR" },
  "taxes": [
    { "taxId": {{tax153}}, "baseAmount": { "minor": 1000000, "currency": "PKR" },
      "rateApplied": "8.0000", "atlStatusUsed": "non_atl", "atlParty": "vendor",
      "amount": { "minor": 80000, "currency": "PKR" }, "deductedBy": "us" }
  ]
}


### ---- 6.9 Transfer, bank to office cash, with a bank fee (worked example 8) --

### 6.9a Expect 201: transfer.amount 6000000, fee 5000, from.name
# "Winibex bank" with the 17th journal number, to.name "Office cash" with
# the 18th.
# @name xfer1
POST {{api}}/transfers
Authorization: Bearer {{owner}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "date": "{{today}}",
  "fromAccountId": {{bankId}},
  "toAccountId": {{cashId}},
  "amount": { "minor": 6000000, "currency": "PKR" },
  "fee": { "minor": 5000, "currency": "PKR" },
  "description": "Cash withdrawal for office"
}

### 6.9b Both legs. Expect 200: two legs sharing the transferGroupId, out
# leg amount 6005000 on the bank, in leg amount 6000000 on office cash.
GET {{api}}/transfers/{{xfer1.response.body.$.transfer.transferGroupId}}
Authorization: Bearer {{owner}}

### 6.9c Out leg journal. Expect: 1118 debit 6000000, 8100 debit 5000,
# 1113 credit 6005000.
GET {{api}}/transactions/{{xfer1.response.body.$.transfer.from.transactionId}}/journal
Authorization: Bearer {{owner}}

### 6.9d In leg journal. Expect: 1111 debit 6000000, 1118 credit 6000000.
GET {{api}}/transactions/{{xfer1.response.body.$.transfer.to.transactionId}}/journal
Authorization: Bearer {{owner}}

### 6.9e Same account on both sides.
# Expect 400, TRANSFER_SAME_ACCOUNT, "A transfer needs two different accounts."
POST {{api}}/transfers
Authorization: Bearer {{owner}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "date": "{{today}}",
  "fromAccountId": {{bankId}},
  "toAccountId": {{bankId}},
  "amount": { "minor": 100000, "currency": "PKR" }
}


### ---- 6.10 Transfer, office cash to petty cash, no fee -----------------------

### 6.10a Expect 201 with the 19th and 20th journal numbers, and no warning.
# (D6 fixed: the second leg used to match the first and answer 409.)
POST {{api}}/transfers
Authorization: Bearer {{owner}}
Content-Type: application/json
Idempotency-Key: {{$guid}}

{
  "date": "{{today}}",
  "fromAccountId": {{cashId}},
  "toAccountId": {{pettyId}},
  "amount": { "minor": 500000, "currency": "PKR" },
  "description": "Petty cash top up"
}


